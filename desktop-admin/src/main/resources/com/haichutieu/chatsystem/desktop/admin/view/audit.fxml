<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      spacing="12" styleClass="admin-screen">
    <Label styleClass="title" text="%admin.audit.title"/>
    <HBox alignment="CENTER_LEFT" spacing="8" styleClass="admin-toolbar">
        <Button fx:id="reloadButton" styleClass="secondary-button" text="%admin.audit.reload"/>
        <Label fx:id="statusLabel" styleClass="admin-status" text="%admin.audit.loading"/>
    </HBox>
    <TableView fx:id="auditTable" styleClass="admin-table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="whenColumn" prefWidth="170" text="%admin.audit.when"/>
            <TableColumn fx:id="actionColumn" prefWidth="220" text="%admin.audit.action"/>
            <TableColumn fx:id="actorColumn" prefWidth="220" text="%admin.audit.actor"/>
            <TableColumn fx:id="targetColumn" prefWidth="220" text="%admin.audit.target"/>
        </columns>
    </TableView>
</VBox>
