<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      spacing="12" styleClass="admin-screen">
    <Label styleClass="title" text="%admin.registrations.title"/>
    <HBox alignment="CENTER_LEFT" spacing="8" styleClass="admin-toolbar">
        <DatePicker fx:id="fromDate" promptText="%admin.registrations.from"/>
        <DatePicker fx:id="toDate" promptText="%admin.registrations.to"/>
        <TextField fx:id="filterField" promptText="%admin.registrations.filterPrompt" HBox.hgrow="ALWAYS"/>
        <Button fx:id="applyButton" styleClass="secondary-button" text="%admin.registrations.apply"/>
        <Label fx:id="statusLabel" styleClass="admin-status" text="%admin.registrations.loading"/>
    </HBox>
    <TableView fx:id="registrationsTable" styleClass="admin-table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="usernameColumn" prefWidth="150" text="%admin.registrations.username"/>
            <TableColumn fx:id="fullNameColumn" prefWidth="190" text="%admin.registrations.fullName"/>
            <TableColumn fx:id="emailColumn" prefWidth="230" text="%admin.registrations.email"/>
            <TableColumn fx:id="statusColumn" prefWidth="110" text="%admin.registrations.status"/>
            <TableColumn fx:id="createdColumn" prefWidth="150" text="%admin.registrations.created"/>
        </columns>
    </TableView>
</VBox>
