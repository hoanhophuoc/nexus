<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      spacing="12" styleClass="admin-screen">
    <Label styleClass="title" text="%admin.reports.title"/>
    <HBox alignment="CENTER_LEFT" spacing="8" styleClass="admin-toolbar">
        <TextField fx:id="reportedUsernameField" promptText="%admin.reports.filterPrompt" HBox.hgrow="ALWAYS"/>
        <DatePicker fx:id="fromDate" promptText="%admin.reports.from"/>
        <DatePicker fx:id="toDate" promptText="%admin.reports.to"/>
        <Button fx:id="loadButton" styleClass="secondary-button" text="%admin.reports.load"/>
        <Label fx:id="statusLabel" styleClass="admin-status" text="%admin.reports.loading"/>
    </HBox>
    <HBox alignment="CENTER_LEFT" spacing="8" styleClass="admin-toolbar">
        <CheckBox fx:id="lockOnUphold" text="%admin.reports.lockOnUphold"/>
        <TextField fx:id="noteField" promptText="%admin.reports.notePrompt" HBox.hgrow="ALWAYS"/>
    </HBox>
    <VBox fx:id="decisionConfirmBox" spacing="6" managed="false" visible="false"
          styleClass="admin-confirm">
        <Label fx:id="decisionConfirmLabel" styleClass="body" text="%admin.reports.decisionConfirmHint"
               wrapText="true"/>
        <HBox spacing="7">
            <Button fx:id="confirmDecisionButton" styleClass="danger-button"
                    text="%admin.reports.confirmDecisionAction"/>
            <Button fx:id="cancelDecisionButton" styleClass="ghost-button"
                    text="%admin.common.cancel"/>
        </HBox>
    </VBox>
    <SplitPane fx:id="reportsSplit" dividerPositions="0.62" orientation="VERTICAL"
               styleClass="admin-split" VBox.vgrow="ALWAYS">
        <items>
            <VBox spacing="8">
                <TableView fx:id="reportsTable" styleClass="admin-table" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="reportedColumn" minWidth="115" prefWidth="130"
                                     text="%admin.reports.reportedUser"/>
                        <TableColumn fx:id="reporterColumn" minWidth="95" prefWidth="120"
                                     text="%admin.reports.reporter"/>
                        <TableColumn fx:id="statusColumn" minWidth="75" prefWidth="100"
                                     text="%admin.reports.status"/>
                        <TableColumn fx:id="reasonColumn" minWidth="260" prefWidth="280"
                                     text="%admin.reports.reason"/>
                        <TableColumn fx:id="createdColumn" minWidth="125" prefWidth="140"
                                     text="%admin.reports.created"/>
                        <TableColumn fx:id="evidenceColumn" minWidth="160" prefWidth="170"
                                     text="%admin.reports.evidence"/>
                        <TableColumn fx:id="decisionColumn" minWidth="220" prefWidth="240"
                                     text="%admin.reports.decision"/>
                    </columns>
                </TableView>
            </VBox>
            <VBox spacing="6">
                <Label fx:id="evidenceTitle" styleClass="admin-section-title" text="%admin.reports.evidenceTitle"/>
                <Label fx:id="evidenceStatus" styleClass="admin-status" text="%admin.reports.evidenceHint"
                       wrapText="true"/>
                <TableView fx:id="evidenceTable" styleClass="admin-table" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="evidenceMessageColumn" prefWidth="250"
                                     text="%admin.reports.evidenceMessage"/>
                        <TableColumn fx:id="evidenceContentColumn" prefWidth="400"
                                     text="%admin.reports.evidenceContent"/>
                    </columns>
                </TableView>
            </VBox>
        </items>
    </SplitPane>
</VBox>
