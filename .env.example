# Copy this file to .env and adjust the values before running `docker compose up`.
# .env is git-ignored.

# --- PostgreSQL ---
POSTGRES_DB=nexus
POSTGRES_USER=nexus
POSTGRES_PASSWORD=change-me

# --- Redis ---
NEXUS_REDIS_PASSWORD=change-me

# --- SMTP password reset delivery ---
NEXUS_EMAIL_HOST=localhost
NEXUS_EMAIL_PORT=25
NEXUS_EMAIL_USERNAME=
NEXUS_EMAIL_PASSWORD=
NEXUS_EMAIL_AUTH=false
NEXUS_EMAIL_STARTTLS=false
NEXUS_EMAIL_FROM=no-reply@localhost
# The API stays healthy when SMTP is absent; enable only if mail must be part of readiness.
NEXUS_MAIL_HEALTH_ENABLED=false

# --- Server ---
# Host port the chat server is published on.
NEXUS_SERVER_PORT=8080
# Set false only for local HTTP development; production must use TLS.
NEXUS_SECURE_COOKIE=true

