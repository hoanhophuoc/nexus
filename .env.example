# Copy this file to .env and adjust the values before running `docker compose up`.
# .env is git-ignored.

# --- PostgreSQL ---
POSTGRES_DB=chat_system
POSTGRES_USER=chat
POSTGRES_PASSWORD=change-me

# --- Redis ---
CHAT_REDIS_PASSWORD=change-me

# --- SMTP password reset delivery ---
CHAT_EMAIL_HOST=localhost
CHAT_EMAIL_PORT=25
CHAT_EMAIL_USERNAME=
CHAT_EMAIL_PASSWORD=
CHAT_EMAIL_AUTH=false
CHAT_EMAIL_STARTTLS=false
CHAT_EMAIL_FROM=no-reply@localhost
# The API stays healthy when SMTP is absent; enable only if mail must be part of readiness.
CHAT_MAIL_HEALTH_ENABLED=false

# --- Server ---
# Host port the chat server is published on.
CHAT_SERVER_PORT=8080
# Set false only for local HTTP development; production must use TLS.
CHAT_SECURE_COOKIE=true

